{
  "functions": {
    "api/**/*.php": {
      "runtime": "php:8.2"
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1.php" },
    { "src": "/(css|img|js)/(.*)", "dest": "/$1/$2" },
    { "src": "/index.php", "dest": "/api/index.php" },
    { "src": "/", "dest": "/api/index.php" }
  ]
}
