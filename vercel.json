{
  "functions": {
    "api/**/*.php": {
      "runtime": "php:8.2"
    }
  },
  "routes": [
    { "src": "/((?!api).*\\.(?:css|js|jpg|jpeg|png|gif|ico|svg|woff|woff2|ttf|eot))", "dest": "/$1" },
    { "src": "/(css|img|js)/(.*)", "dest": "/$1/$2" },
    { "src": "/([a-z]+)\\.php", "dest": "/api/$1.php" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ],
  "env": {
    "PHP_MEMORY_LIMIT": "512M"
  }
}
